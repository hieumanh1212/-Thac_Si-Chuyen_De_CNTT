# Sao chép file này thành .env rồi điền key. KHÔNG commit file .env.

# --- Chọn provider (ghi đè giá trị trong configs/config.yaml) ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5

# Provider "anthropic"
ANTHROPIC_API_KEY=

# Provider "openai" (OpenAI, hoặc dịch vụ tương thích OpenAI như Gemini / Ollama)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# Ví dụ Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Ví dụ Ollama:  LLM_BASE_URL=http://localhost:11434/v1   (không cần key)
# LLM_BASE_URL=
